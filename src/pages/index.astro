	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="data:," />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Татьяна Степанова — хоумстейджинг и декорирование интерьеров. Портфолио скоро появится на сайте." />
		<meta name="robots" content="noindex, nofollow" />
